# Slack Export Configuration
# Copy this file to .env and fill in your values

# Required: Your Slack Bot User OAuth Token
export SLACK_BOT_TOKEN="xoxb-your-token-here"

# Optional: Your Slack App-Level Token
export SLACK_APP_TOKEN="xapp-your-token-here"

# Optional: Comma-separated list of specific channel IDs to export
# If empty or omitted, the tool will auto-discover all channels where the bot is invited
# To find channel ID: Right-click channel → View channel details → Copy Channel ID
export SLACK_CHANNEL_IDS=""

# Required: Output directory for markdown files
export SLACK_EXPORT_PATH="./slack-exports"

# Auto-Discovery Behavior (when SLACK_CHANNEL_IDS is empty):
# - Includes: public and private channels where bot is a member
# - Excludes: archived channels, DMs, group DMs
# - To export specific channels only, set SLACK_CHANNEL_IDS above

# Usage:
# 1. Set SLACK_BOT_TOKEN to your actual bot token
# 2. Leave SLACK_CHANNEL_IDS empty for auto-discovery, or specify channel IDs
# 3. Optionally adjust SLACK_EXPORT_PATH
# 4. Source this file: source .env.example
# 5. Run the tool: ./bin/slack-export
